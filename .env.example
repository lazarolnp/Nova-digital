# Caminho do banco SQLite (precisa de disco persistente)
DATABASE_PATH=./data/novadigital.db

# Assistente de IA (Claude / Anthropic). Sem a chave, o assistente fica desativado
# e a interface informa isso — nenhuma resposta é simulada.
ANTHROPIC_API_KEY=
# Modelo usado pelo assistente (opcional)
AI_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high
AI_EFFORT=medium

# URL pública do site (usada para validar a origem de requisições)
APP_URL=http://localhost:3000

# Canal de suporte exibido na página de Suporte (opcional)
SUPPORT_EMAIL=

# E-mail que vira administrador ao se cadastrar (opcional).
# Alternativa: npm run make-admin -- email@exemplo.com
ADMIN_EMAIL=
