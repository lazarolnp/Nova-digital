# Banco de dados (libSQL/Turso).
# Produção (Vercel): crie um banco no Turso e preencha as duas variáveis abaixo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Desenvolvimento local: sem as variáveis acima, usa o arquivo data/novadigital.db.
# Para outro arquivo: DATABASE_URL=file:./data/outro.db

# Assistente de IA (Claude / Anthropic). Sem a chave, o assistente fica desativado
# e a interface informa isso — nenhuma resposta é simulada.
ANTHROPIC_API_KEY=
# Modelo usado pelo assistente (opcional)
AI_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high
AI_EFFORT=medium

# URL pública do site (usada para validar a origem de requisições)
APP_URL=http://localhost:3000

# Canal de suporte exibido na página de Suporte (opcional)
SUPPORT_EMAIL=

# E-mail que vira administrador ao se cadastrar (opcional).
# Alternativa: npm run make-admin -- email@exemplo.com
ADMIN_EMAIL=

# Kiwify: token do webhook (Kiwify → Apps → Webhooks). Libera o acesso automaticamente após o pagamento.
KIWIFY_WEBHOOK_TOKEN=
